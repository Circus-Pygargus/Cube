{% extends 'base.html.twig' %}

{% block title %}Cube{% endblock %}

{% block body %}
<div class="row">
	<div class="col col-cube-scramble">
		<div id="cube-scramble_form">
			{{ form(cubeTypeForm) }}
		</div>
		<button id="cube-scramble">Obtenir un nouveau mélange</button>
	</div>
	<div id="game-interface" class="col col-game-interface">
		{% block gameInterface %}
			{# This content will be filled on fetch made from button#cube-scramble clic #}
		{% endblock %}
	</div>
	<button type="submit" id="chrono_submit" name="chrono[submit]" class="btn chrono-submit_btn hidden" disabled>Enregistrer</button>
	<div class="col col-chronos-infos">
		{{ include('layout/game/_chronos-infos.html.twig', { 'chronosInfos': chronosInfos }) }}
	</div>
</div>
{% endblock %}


{% block javascripts %}
    {{ encore_entry_script_tags('game') }}
{% endblock %}

{% block gameInterface %}
    {{ form(cubeTypeForm) }}
    <button id="cube-scramble">Obtenir un nouveau mélange</button>

    <div>
    {% for move in scrambleMoves %}
        <div>{{ move }}</div>
    {% endfor %}
    </div>

    {{ form(chronoForm) }}
    <div>
        <button id="chrono-btn-1" class="chrono-btn">{{ isUsingTouchScreen ? 'Presse ici' : 'Presse CTRL gauche' }} </button>
        <button id="chrono-btn-2" class="chrono-btn">{{ isUsingTouchScreen ? 'Presse ici' : 'Presse CTRL droit' }} </button>
    </div>
{% endblock %}

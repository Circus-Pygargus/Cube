{% block gameInterface %}
    <div id="scramble-moves" class="scramble-moves">
    {% for move in scrambleMoves %}
        <div>{{ move }}</div>
    {% endfor %}
    </div>

    <div id="chrono-form-container" class="hidden">
        <div id="readable-duration-container">
            <span>Durée</span>
            <div id="readable-duration"></div>
        </div>
        {{ form(chronoForm) }}
    </div>
    <div id="record-msg"></div>
    <div id="timer-circle" class="hidden">
        <div id="go-text" class="hidden">
            <span>GO</span>
        </div>
    </div>
    <div id="clock-container" class="hidden">
        <div id="clock"></div>
    </div>
    <div id="dual-press-hint">
        {% if isUsingTouchScreen %}
            <div id="chrono-start-hint">Appuie sur les 2 boutons pour lancer le chrono</div>
            <div id="chrono-stop-hint" class="hidden">Appuie sur les 2 boutons pour arrêter le chrono</div>
            <button id="chrono-btn-1" class="chrono-btn">Presse ici</button>
            <button id="chrono-btn-2" class="chrono-btn">Presse ici</button>
        {% else %}
            <div id="chrono-start-hint">Appuie sur les 2 touches CTRL pour lancer le chrono</div>
            <div id="chrono-stop-hint" class="hidden">Appuie sur les 2 touches CTRL pour arrêter le chrono</div>
        {% endif %}
    </div>
{% endblock %}

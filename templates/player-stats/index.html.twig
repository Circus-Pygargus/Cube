{% extends 'base.html.twig' %}

{% block title %}Cube{% endblock %}

{% block body %}
    <div>
        <div id="tabs">
            {% for year in chronoStats|keys|sort %}
                <button class="tab-button{{ loop.last ? ' active' }}" data-year="{{ year }}">
                    {{ year }}
                </button>
            {% endfor %}
        </div>
        <canvas id="main-stats"></canvas>
    </div>
{% endblock %}

{% block javascripts %}
	{{ parent() }}
    <script>const chartData = {{ chronoStatsJson | raw }};</script>
    {{ encore_entry_script_tags('userMainStats') }}
{% endblock %}
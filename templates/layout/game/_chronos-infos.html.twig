{% block chronosInfos %}
	<div id="chronos-infos">
    {% for ci in chronosInfos %}
        <div class="chronos-info">
            <div class="cube-type collapsable-trigger">{{ ci.cubeType }}</div>
            <div class="collapsable">
                <div class="site-record" data-value="{{ ci.siteRecord.duration ?? '' }}">Site record  {{ ci.siteRecord ? format_duration(ci.siteRecord.duration) : '' }}</div>
                <div class="personal-best" data-value="{{ ci.siteRecord.duration ?? '' }}">Personal best {{ ci.personalBest ? format_duration(ci.personalBest.duration) : '' }}</div>
                <div class="session-records" data-cube-type="{{ ci.cubeType }}"></div>
            </div>
        </div>
    {% endfor %}
	</div>
{% endblock %}
